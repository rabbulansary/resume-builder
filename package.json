{
  "name": "resume-builder",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "editor:css": "tailwindcss -i src/resumes/editor/editor.tailwind.css -o src/resumes/editor/editor.generated.css --minify",
    "pdf-editor:css": "tailwindcss -i src/pdf-editor/client/pdf-editor.tailwind.css -o src/pdf-editor/client/pdf-editor.generated.css --minify",
    "css:all": "pnpm editor:css && pnpm pdf-editor:css",
    "build": "pnpm css:all && nest build",
    "deploy": "pnpm css:all && nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "pnpm css:all && nest start",
    "start:dev": "pnpm css:all && nest start --watch",
    "start:debug": "pnpm css:all && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm css:all && vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "express": "^5.3.0",
    "fabric": "^7.4.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@tailwindcss/cli": "^4.3.5",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
